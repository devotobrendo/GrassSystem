#pragma kernel CSMain

struct GrassInputSlim
{
    float3 position;
    float2 widthHeight;
};

struct GrassOutput
{
    float3 position;
    float2 widthHeight;
    float distanceScale;
};

StructuredBuffer<GrassInputSlim> _SourceBuffer;
AppendStructuredBuffer<GrassOutput> _VisibleBuffer;

float4x4 _ViewProjectionMatrix;
float3 _CameraPosition;
float4 _FrustumPlanes[6];

float _MinFadeDistance;
float _MaxDrawDistance;
float _FarKeepFraction;
float _ThinStartDistance;
float _ThinRampDistance;
float2 _SizeScale;
float _CoverageCompensation;
float _MaxCoverageScale;

uint _InstanceCount;

bool IsInFrustum(float3 position, float radius)
{
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float dist = dot(_FrustumPlanes[i].xyz, position) + _FrustumPlanes[i].w;
        if (dist < -radius)
            return false;
    }
    return true;
}

[numthreads(128, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _InstanceCount)
        return;

    GrassInputSlim input = _SourceBuffer[id.x];

    float bladeRadius = max(input.widthHeight.x, input.widthHeight.y) * 0.5;
    if (!IsInFrustum(input.position, bladeRadius))
        return;

    float dist = distance(_CameraPosition, input.position);
    if (dist > _MaxDrawDistance)
        return;

    float distScale = (dist < _MinFadeDistance)
        ? 1.0
        : 1.0 - saturate((dist - _MinFadeDistance) / (_MaxDrawDistance - _MinFadeDistance));
    if (distScale <= 0.01)
        return;

    float thinT = saturate((dist - _ThinStartDistance) / max(_ThinRampDistance, 0.001));
    float keep = lerp(1.0, _FarKeepFraction, thinT);

    uint h = id.x;
    h = (h ^ 61u) ^ (h >> 16u);
    h *= 9u;
    h ^= h >> 4u;
    h *= 0x27d4eb2du;
    h ^= h >> 15u;
    float rnd = h * (1.0 / 4294967295.0);
    if (rnd > keep)
        return;

    float widthComp = min(lerp(1.0, rsqrt(max(keep, 0.001)), _CoverageCompensation), max(_MaxCoverageScale, 1.0));

    GrassOutput output;
    output.position = input.position;
    output.widthHeight = float2(input.widthHeight.x * widthComp, input.widthHeight.y) * _SizeScale;
    output.distanceScale = distScale;

    _VisibleBuffer.Append(output);
}
